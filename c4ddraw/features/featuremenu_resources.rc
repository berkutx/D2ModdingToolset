#include <windows.h>
#include "featuremenu_resources.h"

IDD_C4_OUTPUT_SIZE DIALOGEX 0, 0, 218, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Window/stream output only"
FONT 9, "Segoe UI"
BEGIN
    AUTOCHECKBOX    "Automatic (follow game resolution)", IDC_C4_OUTPUT_AUTO, 9, 9, 200, 12, WS_TABSTOP
    LTEXT           "Width:", IDC_C4_OUTPUT_WIDTH_LABEL, 9, 31, 48, 10
    EDITTEXT        IDC_C4_OUTPUT_WIDTH, 59, 28, 55, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "Height:", IDC_C4_OUTPUT_HEIGHT_LABEL, 121, 31, 39, 10
    EDITTEXT        IDC_C4_OUTPUT_HEIGHT, 162, 28, 47, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "Does not change the game view. The frame, menu and title bar are outside this size.", IDC_C4_OUTPUT_HELP, 9, 51, 200, 37
    DEFPUSHBUTTON   "OK", IDOK, 68, 105, 65, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 141, 105, 68, 16
END
