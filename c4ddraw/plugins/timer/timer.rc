#include <windows.h>
#include "timer_dlg.h"

// Timetable dialog (port of legacy timer.mod resource 5 / sub_100044E0): per-day turn budget.
// Row 0 = the day-1 base; rows 1..3 = checkable "from day N, duration = D" overrides.
IDD_TIMETABLE DIALOGEX 0, 0, 168, 116
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Timetable"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Day", -1, 34, 6, 28, 8
    LTEXT           "Duration", -1, 94, 6, 44, 8
    LTEXT           "1", -1, 34, 21, 28, 9
    EDITTEXT        IDC_TT_DUR0, 94, 18, 44, 13, ES_NUMBER | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "", IDC_TT_ACT1, 12, 36, 12, 12
    EDITTEXT        IDC_TT_DAY1, 34, 35, 44, 13, ES_NUMBER | WS_BORDER | WS_TABSTOP
    EDITTEXT        IDC_TT_DUR1, 94, 35, 44, 13, ES_NUMBER | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "", IDC_TT_ACT2, 12, 52, 12, 12
    EDITTEXT        IDC_TT_DAY2, 34, 51, 44, 13, ES_NUMBER | WS_BORDER | WS_TABSTOP
    EDITTEXT        IDC_TT_DUR2, 94, 51, 44, 13, ES_NUMBER | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "", IDC_TT_ACT3, 12, 68, 12, 12
    EDITTEXT        IDC_TT_DAY3, 34, 67, 44, 13, ES_NUMBER | WS_BORDER | WS_TABSTOP
    EDITTEXT        IDC_TT_DUR3, 94, 67, 44, 13, ES_NUMBER | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 34, 95, 45, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 90, 95, 45, 14
END

// Set dialog (port of legacy resource 6 / DialogFunc): set the current turn's time to N seconds.
// "Set" applies any value (no budget clamp - restoring the budget is what Reset is for); "Pause"
// toggles the clock freeze and is enabled only while the timer is active (same rule as Reset).
IDD_SET DIALOGEX 0, 0, 196, 58
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Set time"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Seconds:", -1, 14, 16, 42, 9
    EDITTEXT        IDC_SET_SEC, 60, 14, 50, 13, ES_NUMBER | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "Set", IDOK, 14, 37, 50, 14
    PUSHBUTTON      "Pause", IDC_SET_PAUSE, 72, 37, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 130, 37, 50, 14
END
