+static BOOL ogl_update_live_resize()
+{
+    if (!InterlockedCompareExchange(&g_ddraw.render.live_resize_active, 0, 0) ||
+        !InterlockedCompareExchange(&g_ogl.live_resize_ready, 0, 0))
+    {
+        g_ogl.live_resize_size = -1;
+        return FALSE;
+    }
+
+    LONG size = InterlockedCompareExchange(&g_ddraw.render.live_resize_size, 0, 0);
+
+    if (size == g_ogl.live_resize_size)
+        return FALSE;
+
+    int output_width = LOWORD(size);
+    int output_height = HIWORD(size);
+
+    if (output_width < (int)g_ddraw.width ||
+        output_height < (int)g_ddraw.height ||
+        output_width > g_ogl.max_viewport_width ||
+        output_height > g_ogl.max_viewport_height)
+    {
+        InterlockedExchange(&g_ogl.live_resize_ready, FALSE);
+        return FALSE;
+    }
+
+    dd_CalcViewport(
+        output_width,
+        output_height,
+        &g_ogl.live_viewport_x,
+        &g_ogl.live_viewport_y,
+        &g_ogl.live_viewport_width,
+        &g_ogl.live_viewport_height);
+
+    g_ogl.live_resize_size = size;
+
+    if (g_ogl.shader1_program && g_ogl.shader1_output_size_uni_loc != -1)
+    {
+        float output_size[2] = {
+            (float)g_ogl.live_viewport_width,
+            (float)g_ogl.live_viewport_height,
+        };
+
+        glUseProgram(g_ogl.shader1_program);
+        glUniform2fv(g_ogl.shader1_output_size_uni_loc, 1, output_size);
+    }
+
+    return TRUE;
+}
