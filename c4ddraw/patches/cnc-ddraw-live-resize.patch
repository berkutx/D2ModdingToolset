+void dd_CalcViewport(int render_width, int render_height, int* x, int* y, int* width, int* height)
+{
+    *x = 0;
+    *y = 0;
+    *width = render_width;
+    *height = render_height;
+
+    if (g_config.boxing)
+    {
+        for (int i = 20; i-- > 1;)
+        {
+            if (g_ddraw.width * i <= render_width && g_ddraw.height * i <= render_height)
+            {
+                *width = i * g_ddraw.width;
+                *height = i * g_ddraw.height;
+                break;
+            }
+        }
+
+        *y = render_height / 2 - *height / 2;
+        *x = render_width / 2 - *width / 2;
+    }
+    else if (g_config.maintas)
+    {
+        double dst_ar;
+        double src_ar = (double)render_height / render_width;
+
+        if (g_config.aspect_ratio[0])
+        {
+            char* e = &g_config.aspect_ratio[0];
+
+            DWORD cx = strtoul(e, &e, 0);
+            DWORD cy = strtoul(e + 1, &e, 0);
+
+            dst_ar = (double)cy / cx;
+        }
+        else
+        {
+            dst_ar = (double)g_ddraw.height / g_ddraw.width;
+        }
+
+        *width = render_width;
+        *height = (int)round(dst_ar * *width);
+
+        if (src_ar < dst_ar)
+        {
+            *width = (int)round(((double)*width / *height) * render_height);
+            *height = render_height;
+        }
+
+        *width = min(*width, render_width);
+        *height = min(*height, render_height);
+
+        *y = render_height / 2 - *height / 2;
+        *x = render_width / 2 - *width / 2;
+    }
+}
