+
+static void ogl_set_output_viewport()
+{
+    int x;
+    int y;
+    int width;
+    int height;
+
+    if (g_ddraw.child_window_exists)
+    {
+        x = 0;
+        y = g_ddraw.render.height - g_ddraw.height;
+        width = g_ddraw.width;
+        height = g_ddraw.height;
+    }
+    else
+    {
+        x = g_ddraw.render.viewport.x;
+        y = g_ddraw.render.viewport.y + g_ddraw.render.opengl_y_align;
+        width = g_ddraw.render.viewport.width;
+        height = g_ddraw.render.viewport.height;
+    }
+
+    DDApplySimpleZoomViewport(TRUE, &x, &y, &width, &height);
+    glViewport(x, y, width, height);
+}
