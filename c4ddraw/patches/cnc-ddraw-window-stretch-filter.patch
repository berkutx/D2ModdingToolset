+/*
+ * The legacy Stretch-windows stage is a source crop, not a larger destination
+ * rectangle. Keep the quad mutable because the published surface classifier can
+ * switch between a strategic frame and a fixed dialog without rebuilding OpenGL.
+ * The FBO orientation matches cnc-ddraw's existing palette/conversion pass; the
+ * direct orientation is the normal back-buffer presentation orientation.
+ */
+static void ogl_update_main_quad(
+    BOOL to_fbo, int left, int top, int width, int height, BOOL force)
+{
+    if (!g_oglu_got_version3 || !g_ogl.main_program ||
+        width <= 0 || height <= 0 ||
+        g_ogl.surface_tex_width <= 0 || g_ogl.surface_tex_height <= 0)
+    {
+        return;
+    }
+
+    if (!force &&
+        g_ogl.quad_to_fbo == to_fbo &&
+        g_ogl.quad_crop_left == left &&
+        g_ogl.quad_crop_top == top &&
+        g_ogl.quad_crop_width == width &&
+        g_ogl.quad_crop_height == height)
+    {
+        return;
+    }
+
+    const GLfloat u0 = (GLfloat)left / (GLfloat)g_ogl.surface_tex_width;
+    const GLfloat v0 = (GLfloat)top / (GLfloat)g_ogl.surface_tex_height;
+    const GLfloat u1 = (GLfloat)(left + width) / (GLfloat)g_ogl.surface_tex_width;
+    const GLfloat v1 = (GLfloat)(top + height) / (GLfloat)g_ogl.surface_tex_height;
+    const GLfloat vertex_to_fbo[] = {
+        -1.0f,-1.0f,
+        -1.0f, 1.0f,
+         1.0f, 1.0f,
+         1.0f,-1.0f,
+    };
+    const GLfloat vertex_to_screen[] = {
+        -1.0f, 1.0f,
+         1.0f, 1.0f,
+         1.0f,-1.0f,
+        -1.0f,-1.0f,
+    };
+    const GLfloat tex_to_fbo[] = {
+        u0, v0,
+        u0, v1,
+        u1, v1,
+        u1, v0,
+    };
+    const GLfloat tex_to_screen[] = {
+        u0, v0,
+        u1, v0,
+        u1, v1,
+        u0, v1,
+    };
+
+    glBindVertexArray(g_ogl.main_vao);
+    glBindBuffer(GL_ARRAY_BUFFER, g_ogl.main_vbos[0]);
+    glBufferData(
+        GL_ARRAY_BUFFER,
+        sizeof(vertex_to_fbo),
+        to_fbo ? vertex_to_fbo : vertex_to_screen,
+        GL_DYNAMIC_DRAW);
+    glBindBuffer(GL_ARRAY_BUFFER, g_ogl.main_vbos[1]);
+    glBufferData(
+        GL_ARRAY_BUFFER,
+        sizeof(tex_to_fbo),
+        to_fbo ? tex_to_fbo : tex_to_screen,
+        GL_DYNAMIC_DRAW);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glBindVertexArray(0);
+
+    g_ogl.quad_to_fbo = to_fbo;
+    g_ogl.quad_crop_left = left;
+    g_ogl.quad_crop_top = top;
+    g_ogl.quad_crop_width = width;
+    g_ogl.quad_crop_height = height;
+}
+
+/* The crop is packed at FBO origin, so later passes sample an origin-based
+ * active rectangle rather than re-reading the centered source coordinates. */
+static void ogl_update_shader1_quad(
+    BOOL to_fbo, int width, int height, BOOL force)
+{
+    if (!g_ogl.shader1_program ||
+        width <= 0 || height <= 0 ||
+        g_ogl.surface_tex_width <= 0 || g_ogl.surface_tex_height <= 0)
+    {
+        return;
+    }
+
+    if (!force &&
+        g_ogl.shader1_quad_to_fbo == to_fbo &&
+        g_ogl.shader1_crop_width == width &&
+        g_ogl.shader1_crop_height == height)
+    {
+        return;
+    }
+
+    const GLfloat u1 = (GLfloat)width / (GLfloat)g_ogl.surface_tex_width;
+    const GLfloat v1 = (GLfloat)height / (GLfloat)g_ogl.surface_tex_height;
+    const GLfloat tex_to_fbo[] = {
+        0.0f, 0.0f,
+        0.0f, v1,
+        u1,   v1,
+        u1,   0.0f,
+    };
+    const GLfloat tex_to_screen[] = {
+        0.0f, 0.0f,
+        u1,   0.0f,
+        u1,   v1,
+        0.0f, v1,
+    };
+
+    glBindVertexArray(g_ogl.shader1_vao);
+    glBindBuffer(GL_ARRAY_BUFFER, g_ogl.shader1_vbos[1]);
+    glBufferData(
+        GL_ARRAY_BUFFER,
+        sizeof(tex_to_fbo),
+        to_fbo ? tex_to_fbo : tex_to_screen,
+        GL_DYNAMIC_DRAW);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glBindVertexArray(0);
+
+    g_ogl.shader1_quad_to_fbo = to_fbo;
+    g_ogl.shader1_crop_width = width;
+    g_ogl.shader1_crop_height = height;
+}
+
+static void ogl_update_shader1_sizes(
+    int input_width, int input_height, int output_width, int output_height)
+{
+    if (!g_ogl.shader1_program)
+        return;
+
+    glUseProgram(g_ogl.shader1_program);
+
+    if (g_ogl.shader1_input_size_uni_loc != -1)
+    {
+        const float input_size[2] = {
+            (float)input_width,
+            (float)input_height,
+        };
+        glUniform2fv(g_ogl.shader1_input_size_uni_loc, 1, input_size);
+    }
+
+    if (g_ogl.shader1_output_size_uni_loc != -1)
+    {
+        const float output_size[2] = {
+            (float)output_width,
+            (float)output_height,
+        };
+        glUniform2fv(g_ogl.shader1_output_size_uni_loc, 1, output_size);
+    }
+}
+
+static void ogl_update_shader2_quad(int width, int height, BOOL force)
