+    const GLfloat u1 = (GLfloat)width / (GLfloat)g_ogl.surface_tex_width;
+    const GLfloat v1 = (GLfloat)height / (GLfloat)g_ogl.surface_tex_height;
+    const GLfloat tex_coord[] = {
+        0.0f, 0.0f,
+        u1,   0.0f,
+        u1,   v1,
