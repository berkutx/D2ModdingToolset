+/* Map a Win32 CLIENT point to the game's render coord space via cnc-ddraw's mouse transform (mirrors
+ * fake_GetCursorPos in winapi_hooks.c). For the C4dll-R map drag-scroll: while LMB is held the game
+ * stops routing WM_MOUSEMOVE to the iso vtable handler, so the captured WndProc (featuremenu) pans -
+ * but it gets client coords while the iso scroll fns use game coords. g_ddraw lives here, so this does. */
+void DDMapClientToGame(long cx, long cy, long* gx, long* gy)
+{
+    int x = (int)cx - g_ddraw.mouse.x_adjust;
+    int y = (int)cy - g_ddraw.mouse.y_adjust;
+    if (g_config.adjmouse && !g_ddraw.child_window_exists)
+    {
+        x = (int)(x * g_ddraw.mouse.unscale_x + (x >= 0 ? 0.5f : -0.5f));
+        y = (int)(y * g_ddraw.mouse.unscale_y + (y >= 0 ? 0.5f : -0.5f));
+    }
+    if (x < 0) x = 0; else if (x > (int)g_ddraw.width - 1) x = (int)g_ddraw.width - 1;
+    if (y < 0) y = 0; else if (y > (int)g_ddraw.height - 1) y = (int)g_ddraw.height - 1;
+    if (gx) *gx = x;
+    if (gy) *gy = y;
+}
