+/*
+ * Re-read ddraw.ini and re-apply the current video settings LIVE (no game restart).
+ * Added for the C4dll-R in-game Options menu (features/featuremenu.cpp). dd_SetDisplayMode re-applies
+ * shader / maintas / boxing / vsync / resolution (width,height) / windowed-fullscreen-border
+ * from the freshly-read g_config. (A renderer backend switch still needs a restart: the active
+ * g_ddraw.renderer pointer is resolved once at init, not here.) Call from the game's GUI thread.
+ */
+void DDReloadConfig()
+{
+    TRACE("%s [%p]\n", __FUNCTION__, _ReturnAddress());
+
+    if (!g_ddraw.ref || !g_ddraw.hwnd || !g_ddraw.width)
+        return;
+
+    /* Keep the current window position across the re-read (ini posX/posY default to centered). */
+    LONG saved_left = g_config.window_rect.left;
+    LONG saved_top = g_config.window_rect.top;
+
+    cfg_load();
+
+    if (g_config.window_rect.left == -32000)
+        g_config.window_rect.left = saved_left;
+    if (g_config.window_rect.top == -32000)
+        g_config.window_rect.top = saved_top;
+
+    dd_SetDisplayMode(0, 0, 0, 0);
+
+    /* mouse_lock / mouse_unlock / g_mouse_locked live in mouse.h, not included here -> forward-declare. */
+    extern void mouse_lock(void);
+    extern void mouse_unlock(void);
+    extern BOOL g_mouse_locked;
+
+    /* Re-push the cursor clip so map edge-scroll / mouse map onto the NEW render area immediately
+     * (mouse.rc was just recomputed inside dd_SetDisplayMode). Only meaningful while the cursor is
+     * locked; when unlocked the recomputed mouse.unscale (adjmouse) already maps the next move. */
+    if (g_mouse_locked)
+    {
+        mouse_unlock();
+        mouse_lock();
+    }
+
+    /* Force the WHOLE client (including any region a resize just added) to be cleared BY THE RENDERER
+     * and repainted before the next frame, instead of being left black by the game's DefWindowProc
+     * erase brush. Harmless when the render size did not change (one black-then-redraw frame). */
+    InterlockedExchange(&g_ddraw.render.clear_screen, TRUE);
+    if (g_ddraw.render.sem)
+        ReleaseSemaphore(g_ddraw.render.sem, 1, NULL);
+    RedrawWindow(g_ddraw.hwnd, NULL, NULL, RDW_ERASE | RDW_INVALIDATE | RDW_UPDATENOW);
+}
