+/* DisciplesGL lets Windows own maximize/restore/Snap. Resize only the renderer;
+ * the logical DirectDraw canvas and Windows' saved normal placement stay intact. */
+void dd_ResizeWindowOutput(int width, int height, BOOL restore_request)
+{
+    static BOOL resizing = FALSE;
+    RECT saved_request;
+    POINT origin = { 0, 0 };
+    BOOL maximized;
+
+    if (resizing || !g_config.windowed || g_config.fullscreen || !g_config.resizable || !g_config.border ||
+        !g_ddraw.width || !g_ddraw.render.thread || width <= 0 || height <= 0 ||
+        (width == g_ddraw.render.width && height == g_ddraw.render.height))
+        return;
+
+    resizing = TRUE;
+    saved_request = g_config.window_rect;
+    maximized = IsZoomed(g_ddraw.hwnd);
+    g_config.window_rect.right = width;
+    g_config.window_rect.bottom = height;
+    if (!maximized && real_ClientToScreen(g_ddraw.hwnd, &origin))
+    {
+        g_config.window_rect.left = origin.x;
+        g_config.window_rect.top = origin.y;
+    }
+
+    dd_SetDisplayMode(0, 0, 0, SDM_KEEP_WINDOW);
+    /* Maximizing is temporary. Do not save the monitor's client dimensions over
+     * an explicit output request or width=0/height=0 automatic sizing. */
+    if (maximized || restore_request)
+        g_config.window_rect = saved_request;
+    resizing = FALSE;
+}
