+        native_client.right > 0 && native_client.bottom > 0 &&
+        (real_GetWindowLongA(g_ddraw.hwnd, GWL_STYLE) & WS_CAPTION) == WS_CAPTION &&
+        ((dwFlags & SDM_KEEP_WINDOW) ||
+            IsZoomed(g_ddraw.hwnd) ||
+            (g_config.window_rect.right == native_client.right &&
+             g_config.window_rect.bottom == native_client.bottom));
     InterlockedExchange(&g_ddraw.render.live_resize_active, FALSE);
 
     if (!dwWidth)
@@ -774,7 +820,7 @@
